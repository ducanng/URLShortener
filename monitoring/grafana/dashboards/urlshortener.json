{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Request Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(gin_requests_total[1m])) by (code)",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      }
    },
    {
      "title": "Request Latency (P50 / P95 / P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(gin_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(gin_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(gin_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(gin_requests_total{code=~\"4..|5..\"}[1m])) / sum(rate(gin_requests_total[1m])) * 100",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" },
        "overrides": []
      }
    },
    {
      "title": "Goroutines",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "go_goroutines{job=\"urlshortener\"}",
          "legendFormat": "goroutines",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Heap Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "go_memstats_heap_inuse_bytes{job=\"urlshortener\"}",
          "legendFormat": "heap inuse",
          "refId": "A"
        },
        {
          "expr": "go_memstats_heap_alloc_bytes{job=\"urlshortener\"}",
          "legendFormat": "heap alloc",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      }
    },
    {
      "title": "Redis Hit Ratio",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total[1m]) / (rate(redis_keyspace_hits_total[1m]) + rate(redis_keyspace_misses_total[1m])) * 100",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 80 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Redis Memory",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "used",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      }
    },
    {
      "title": "PostgreSQL Active Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=\"url_shortener\"}",
          "legendFormat": "active connections",
          "refId": "A"
        }
      ]
    },
    {
      "title": "PostgreSQL Rows Inserted/s",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_inserted{datname=\"url_shortener\"}[1m])",
          "legendFormat": "inserts/s",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_tup_fetched{datname=\"url_shortener\"}[1m])",
          "legendFormat": "fetches/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      }
    },
    {
      "title": "PostgreSQL Pool: Connections",
      "description": "go_sql_* from internal/metrics.RegisterDBStats (per-instance sql.DB.Stats()). open should stay under max (cap) — see PG_MAX_OPEN_CONNS in .env.example.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "sum by (instance) (go_sql_open_connections)",
          "legendFormat": "{{instance}} open",
          "refId": "A"
        },
        {
          "expr": "sum by (instance) (go_sql_in_use_connections)",
          "legendFormat": "{{instance}} in_use",
          "refId": "B"
        },
        {
          "expr": "sum by (instance) (go_sql_idle_connections)",
          "legendFormat": "{{instance}} idle",
          "refId": "C"
        },
        {
          "expr": "sum by (instance) (go_sql_max_open_connections)",
          "legendFormat": "{{instance}} max (cap)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "title": "PostgreSQL Pool: Wait Count / Duration",
      "description": "Direct saturation signal: rising waits/s or avg wait time means requests are blocking to borrow a pool connection. See docs/k6-load-testing.md bottleneck playbook.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "sum by (instance) (rate(go_sql_wait_count_total[1m]))",
          "legendFormat": "{{instance}} waits/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(go_sql_wait_duration_seconds_total[1m])) / sum(rate(go_sql_wait_count_total[1m]))",
          "legendFormat": "avg wait time",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "avg wait time" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      }
    },
    {
      "title": "Nginx: Connections",
      "description": "waiting = connections queued by Nginx itself (worker_connections / upstream keepalive pressure) — the direct signal for whether the LB, not just the app, is the bottleneck. Requires nginx-exporter (docker-compose.monitoring.yml) scraping the internal :8081/nginx_status stub_status endpoint.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [
        {
          "expr": "nginx_connections_active",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "nginx_connections_reading",
          "legendFormat": "reading",
          "refId": "B"
        },
        {
          "expr": "nginx_connections_writing",
          "legendFormat": "writing",
          "refId": "C"
        },
        {
          "expr": "nginx_connections_waiting",
          "legendFormat": "waiting (queued)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["urlshortener"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "URL Shortener Dashboard",
  "uid": "urlshortener-main",
  "version": 1
}
