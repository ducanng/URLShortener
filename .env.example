# --- Application DSNs ---
# Used by both `go run .` (local dev) and `docker compose` (containers).
# Pick hostnames according to where the app runs:
#   - localhost     : when running the Go binary directly on the host
#   - db / redis-db : when running inside docker compose (service names)
#
# The Postgres compose service exposes 5432 on the host, so `localhost` works
# from the host while the compose stack is up.
DB=postgres://postgres:secret@localhost:5432/url_shortener?sslmode=disable
REDIS_ADDR=localhost:6379

# --- CORS ---
# Comma-separated list of allowed origins for cross-origin requests.
# In production set this to your frontend domain(s), e.g.:
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# When unset the server falls back to localhost dev origins only.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Grafana admin (docker-compose.monitoring.yml) ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin